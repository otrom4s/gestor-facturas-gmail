# Puerto del servidor
PORT=3000

# Google OAuth 2.0 (Obtenido en Google Cloud Console -> APIs y Servicios -> Credenciales)
# URI de redirección autorizada: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Gemini API Key (Obtenido gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key
